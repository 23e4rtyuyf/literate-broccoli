# CrisisGrid environment variables
# Copy to .env and fill in any values you want to override.

# No external API keys are required.
# Maps use OpenStreetMap (free, no account needed).
# Address autocomplete uses Nominatim (free, no account needed).

# Optional: set the backend URL if not using the Vite proxy
# VITE_API_BASE=http://localhost:8000/api

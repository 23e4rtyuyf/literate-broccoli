# CrisisGrid — Backend Environment Variables
# These are all optional. The app runs fine without any of them.
# Set these in your server environment or a .env loader of your choice.

# ── Email / SMTP (optional) ────────────────────────────────────────────────
# If not set, crisis alert emails are silently skipped.
# Works with Gmail, SendGrid, Mailgun, Postmark, or any SMTP provider.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# "From" address shown on outgoing alert emails
SMTP_FROM=noreply@yourdomain.com

# ── App URL ────────────────────────────────────────────────────────────────
# Public-facing frontend URL — used to build links inside email notifications.
APP_URL=https://yourdomain.com
